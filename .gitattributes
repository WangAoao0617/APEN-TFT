# 自动识别文本文件
# Automatically detect text files
* text=auto

# 源代码和配置文件统一使用 LF 换行符
# Use LF for source and configuration files
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.cff text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.svg text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# 标记二进制文件
# Mark binary files
*.ckpt binary
*.pth binary
*.pt binary
*.xlsx binary
*.xls binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
